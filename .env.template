# Open XLIFF Translator - Environment Configuration Template
# Copy this file to .env and adjust values as needed

# ============================================
# Application Settings
# ============================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Port for the FastAPI application
APP_PORT=5003


# ============================================
# File Management
# ============================================

# Directory for uploaded XLIFF files (temporary storage)
UPLOAD_FOLDER=uploads

# Directory for processed/translated XLIFF files
PROCESSED_FOLDER=processed

# How long a translated file stays re-downloadable from the history list.
# Also bounds the lifetime of the anonymous history session cookie.
FILE_RETENTION_DAYS=7

# Maximum accepted upload size in bytes. Anything larger is rejected with
# 413 before it is written to disk. Default is 50 MB (52428800).
MAX_UPLOAD_BYTES=52428800


# ============================================
# Retention Cleanup
# ============================================

# How long uploaded and processed files are kept before the periodic cleanup
# removes them. Fractional values are allowed (0.5 = 12 hours).

# How often the cleanup pass runs. It also runs once at application startup.
CLEANUP_INTERVAL_HOURS=6

# How long a finished translation job stays in the in-memory job store after it
# completes, so a client still polling /progress/{job_id} gets an answer
# instead of a 404.
JOB_GRACE_PERIOD_MINUTES=15


# ============================================
# Persistence
# ============================================

# SQLite database file. Must live on a mounted volume in Docker, or the
# vocabulary and history are lost on every image rebuild.
DATABASE_PATH=data/glossary.db


# ============================================
# Translation Settings
# ============================================

# LibreTranslate API endpoint for translation
# For Docker: http://libretranslate:5000/translate
# For local: http://localhost:5002/translate
LIBRETRANSLATE_URL=http://libretranslate:5000/translate

# LibreTranslate API endpoint for language list
# For Docker: http://libretranslate:5000/languages
# For local: http://localhost:5002/languages
LIBRETRANSLATE_LANGUAGES_URL=http://libretranslate:5000/languages

# Default target language for translation (ISO 639-1 code)
# Examples: da (Danish), de (German), fr (French), es (Spanish)
DEFAULT_TARGET_LANGUAGE=da

# Apply vocabulary overrides during translation. Set to false to bypass the
# glossary entirely without deleting any terms.
GLOSSARY_ENABLED=true


# ============================================
# HTTP Client Settings
# ============================================

# Timeout for HTTP requests in seconds
HTTP_TIMEOUT=30.0

# Connection timeout for HTTP requests in seconds
HTTP_CONNECT_TIMEOUT=10.0

# Maximum number of retry attempts for failed requests
MAX_RETRIES=3

# Maximum number of concurrent HTTP connections
MAX_CONNECTIONS=10

# Maximum number of keepalive HTTP connections
MAX_KEEPALIVE_CONNECTIONS=5


# ============================================
# Rate Limiting
# ============================================

# Master switch. Set to false to disable rate limiting entirely.
RATE_LIMIT_ENABLED=true

# Default limit applied to every endpoint except /upload.
# Keep this comfortably above 60/minute: the web UI polls /progress once per
# second while a translation runs, so a single active user costs ~60 req/min.
RATE_LIMIT_DEFAULT=120/minute

# Limit for /upload, the expensive endpoint. One request spawns a job that makes
# one LibreTranslate call per trans-unit (a real file in this repo has 452),
# each with up to MAX_RETRIES attempts, sharing MAX_CONNECTIONS connections.
RATE_LIMIT_UPLOAD=5/minute

# Counter storage. "memory://" is per-process; use e.g. "redis://host:6379"
# to share limits across multiple app replicas.
RATE_LIMIT_STORAGE_URI=memory://

# Whether to take the client IP from the X-Forwarded-For header.
# Leave false when the app is exposed directly: the header is client-supplied
# and spoofing it would bypass the limit. Set to true ONLY behind a reverse
# proxy you control that sets the header - otherwise every request behind the
# proxy shares one key and the limit becomes global.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Note: /health is never rate limited, so the Docker healthcheck (every 30s)
# cannot throttle the container into an unhealthy state.
